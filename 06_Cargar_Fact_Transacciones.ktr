<?xml version='1.0' encoding='utf-8'?>
<transformation><info><name>06_Cargar_Fact_Transacciones</name><description>Carga la tabla de hechos</description><extended_description>Conexión BD_CREDIT_CARD: localhost:3306/credit_card_db, usuario root. Ajustar credenciales en Spoon si corresponde.</extended_description><trans_version>1.0</trans_version><trans_type>Normal</trans_type><directory>/</directory><parameters /><log /><maxdate /><size_rowset>10000</size_rowset></info><notepads /><connection><name>BD_CREDIT_CARD</name><server>localhost</server><type>MYSQL</type><access>Native</access><database>credit_card_db</database><port>3306</port><username>root</username><password /><servername /><data_tablespace /><index_tablespace /><attributes><attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute></attributes></connection><step><name>Consultar origen</name><type>TableInput</type><description>Consulta los registros de staging para alimentar la dimensión o tabla de hechos.</description><distribute>Y</distribute><custom_distribution /><copies>1</copies><partitioning><method> </method><schema_name> </schema_name></partitioning><connection>BD_CREDIT_CARD</connection><sql>SELECT t.tarjeta_key, CAST(DATE_FORMAT(s.fecha,'%Y%m%d') AS UNSIGNED) AS fecha_key,
 a.autorizacion_key, c.comprador_key, s.hora,
 CASE WHEN s.monto IS NULL OR TRIM(s.monto)='' THEN NULL
      ELSE CAST(REPLACE(REPLACE(REPLACE(TRIM(s.monto),'$',''),',',''),' ','') AS DECIMAL(12,2)) END AS monto,
 s.intentos_cvv, s.devoluciones, s.reclamaciones, s.total_compras
 FROM credit_card_fraud_test s
 JOIN dim_tarjeta t ON t.nombre_tarjeta=s.nombre_tarjeta AND t.tipo_tarjeta=s.tipo_tarjeta
 JOIN dim_autorizacion a ON a.codigo_autorizacion=s.autorizacion
 JOIN dim_comprador c ON c.comprador_recurrente=s.comprador_recurrente
 WHERE s.fecha IS NOT NULL</sql><limit>0</limit><lookup /><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active><attributes /><GUI><xloc>128</xloc><yloc>128</yloc><draw>Y</draw></GUI></step><step><name>Cargar destino</name><type>TableOutput</type><description>Inserta registros en fact_transacciones.</description><distribute>Y</distribute><custom_distribution /><copies>1</copies><partitioning><method> </method><schema_name> </schema_name></partitioning><connection>BD_CREDIT_CARD</connection><schema /><table>fact_transacciones</table><commit>1000</commit><truncate>N</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields><partitioning_enabled>N</partitioning_enabled><tablename_in_field>N</tablename_in_field><tablename_field /><tablename_in_table>N</tablename_in_table><fields><field><column_name>tarjeta_key</column_name><stream_name>tarjeta_key</stream_name></field><field><column_name>fecha_key</column_name><stream_name>fecha_key</stream_name></field><field><column_name>autorizacion_key</column_name><stream_name>autorizacion_key</stream_name></field><field><column_name>comprador_key</column_name><stream_name>comprador_key</stream_name></field><field><column_name>hora</column_name><stream_name>hora</stream_name></field><field><column_name>monto</column_name><stream_name>monto</stream_name></field><field><column_name>intentos_cvv</column_name><stream_name>intentos_cvv</stream_name></field><field><column_name>devoluciones</column_name><stream_name>devoluciones</stream_name></field><field><column_name>reclamaciones</column_name><stream_name>reclamaciones</stream_name></field><field><column_name>total_compras</column_name><stream_name>total_compras</stream_name></field></fields><attributes /><GUI><xloc>500</xloc><yloc>128</yloc><draw>Y</draw></GUI></step><order><hop><from>Consultar origen</from><to>Cargar destino</to><enabled>Y</enabled></hop></order><step_error_handling /><slave-step-copy-partition-distribution /><slave_transformation /><cluster_schema /><created_user /><created_date /><modified_user /><modified_date /><attributes /><metrics /></transformation>