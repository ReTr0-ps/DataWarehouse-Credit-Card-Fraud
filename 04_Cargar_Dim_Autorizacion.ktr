<transformation><info><name>04_Cargar_Dim_Autorizacion</name><description>Carga la dimensión de autorización</description><extended_description>Conexión BD_CREDIT_CARD: localhost:3306/credit_card_db, usuario root. Ajustar credenciales en Spoon si corresponde.</extended_description><trans_version>1.0</trans_version><trans_type>Normal</trans_type><directory>/</directory><parameters /><log /><maxdate /><size_rowset>10000</size_rowset></info><notepads /><connection><name>BD_CREDIT_CARD</name><server>localhost</server><type>MYSQL</type><access>Native</access><database>credit_card_db</database><port>3306</port><username>root</username><password /><servername /><data_tablespace /><index_tablespace /><attributes><attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute></attributes></connection><step><name>Consultar origen</name><type>TableInput</type><description>Consulta los registros de staging para alimentar la dimensión o tabla de hechos.</description><distribute>Y</distribute><custom_distribution /><copies>1</copies><partitioning><method> </method><schema_name> </schema_name></partitioning><connection>BD_CREDIT_CARD</connection><sql>SELECT DISTINCT autorizacion AS codigo_autorizacion, CASE WHEN autorizacion=1 THEN 'Autorizada' WHEN autorizacion=0 THEN 'No autorizada' ELSE 'Sin clasificar' END AS descripcion FROM credit_card_fraud_test WHERE autorizacion IS NOT NULL</sql><limit>0</limit><lookup /><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active><attributes /><GUI><xloc>128</xloc><yloc>128</yloc><draw>Y</draw></GUI></step><step><name>Cargar destino</name><type>TableOutput</type><description>Inserta registros en dim_autorizacion.</description><distribute>Y</distribute><custom_distribution /><copies>1</copies><partitioning><method> </method><schema_name> </schema_name></partitioning><connection>BD_CREDIT_CARD</connection><schema /><table>dim_autorizacion</table><commit>1000</commit><truncate>N</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields><partitioning_enabled>N</partitioning_enabled><tablename_in_field>N</tablename_in_field><tablename_field /><tablename_in_table>N</tablename_in_table><fields><field><column_name>codigo_autorizacion</column_name><stream_name>codigo_autorizacion</stream_name></field><field><column_name>descripcion</column_name><stream_name>descripcion</stream_name></field></fields><attributes /><GUI><xloc>500</xloc><yloc>128</yloc><draw>Y</draw></GUI></step><order><hop><from>Consultar origen</from><to>Cargar destino</to><enabled>Y</enabled></hop></order><step_error_handling /><slave-step-copy-partition-distribution /><slave_transformation /><cluster_schema /><created_user /><created_date /><modified_user /><modified_date /><attributes /><metrics /></transformation>